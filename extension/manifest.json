{
  "manifest_version": 3,
  "name": "Brave YouTube yt-dlp Downloader",
  "version": "1.0.0",
  "description": "Download YouTube videos directly with local yt-dlp in any resolution (144p to 1080p+, MP3 audio).",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "yt-dlp Downloader Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
